{
  "name": "cronograma-arqvertice",
  "version": "2.1.0",
  "private": true,
  "description": "ArqVértice Flow — fundação moderna em migração incremental do painel legado.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke:remote": "node scripts/smoke-remote.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "whatsapp:cli": "node scripts/whatsapp-bridge.mjs",
    "wagner:setup": "node scripts/setup-wagner.mjs",
    "wagner:reset": "node scripts/reset-wagner.mjs",
    "sync:credentials": "node scripts/sync-credentials.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@prisma/client": "^6.19.3",
    "@supabase/server": "^1.9.2",
    "@types/nodemailer": "^8.0.2",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "next": "^15.5.27",
    "nodemailer": "^10.3.1",
    "pg": "^8.13.1",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "redux": "^5.0.1",
    "resend": "^6.38.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/parser": "^8.44.0",
    "autoprefixer": "^10.4.21",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.36.0",
    "postcss": "^8.5.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^5.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
