  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique // GRD-2026-0001
  projectId      String   @db.Uuid
  recipientName  String
  recipientEmail String?
  recipientOrg   String? // Nome da Construtora / Empreiteira
  subject        String
  notes          String?
  hashToken      String   @unique // Token único para download/verificação
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("AcervoGrdsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  items     AcervoGrdItem[]

  @@index([projectId, createdAt])
}

model AcervoGrdItem {
  id             String @id @default(uuid()) @db.Uuid
  grdId          String @db.Uuid
  revisionId     String @db.Uuid
  documentCode   String
  documentTitle  String
  revisionNumber String
  statusAtIssue  String
  fileUrl        String

  grd      AcervoGrd      @relation(fields: [grdId], references: [id], onDelete: Cascade)
  revision AcervoRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([grdId])
  @@index([revisionId])
}

// Preparação para Release 1B (Visualizador BIM & RFIs)
model AcervoRfiMarkup {
  id           String           @id @default(uuid()) @db.Uuid
  code         String // RFI-001
  documentId   String           @db.Uuid
  revisionId   String           @db.Uuid
  title        String
  description  String
  status       AcervoRfiStatus  @default(ABERTA)
  markupType   AcervoMarkupType @default(PIN)
  pageNumber   Int?             @default(1)
  coordX       Float?
  coordY       Float?
  cameraState  Json? // Câmera 3D BIM (position, target, zoom)
  geometryJson Json? // Vetores da nuvem/cota
  createdById  String?          @db.Uuid
  assignedToId String?          @db.Uuid
  answer       String?
  answeredAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  document   AcervoDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision   AcervoRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  createdBy  User?          @relation("AcervoRfiCreated", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User?          @relation("AcervoRfiAssigned", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([documentId, status])
  @@index([revisionId])
}

// Preparação para Release 1C (Sync API AutoCAD & Revit)
model AcervoApiToken {
  id          String    @id @default(uuid()) @db.Uuid
  name        String // Ex: "Plugin Revit - Estação Wagner"
  tokenHash   String    @unique // SHA-256 do token
  tokenPrefix String // Ex: "av_revit_..."
  projectId   String?   @db.Uuid
  createdById String?   @db.Uuid
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("AcervoApiTokensCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tokenHash])
}

model FeatureVisibility {
  id                String   @id @default(uuid()) @db.Uuid
