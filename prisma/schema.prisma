  bodyHtml         String?     @db.Text
  status           String      @default("SENT") // PENDING_UNDO | SCHEDULED | SENT | CANCELLED | FAILED | RECEIVED
  cancelDeadlineAt DateTime?
  scheduledFor     DateTime?
  sentAt           DateTime?
  providerId       String?
  attachmentsMeta  Json?
