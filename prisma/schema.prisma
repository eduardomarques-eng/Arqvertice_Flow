model Proposal {
  id               String               @id @default(uuid()) @db.Uuid
  projectId        String               @db.Uuid
  status           ProposalStatus       @default(DRAFT)
  currentVersion   Int                  @default(1)
  expiresAt        DateTime?
  sentAt           DateTime?
  viewedAt         DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  approvalIp       String?
