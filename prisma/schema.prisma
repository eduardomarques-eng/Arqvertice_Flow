  @@index([clientId])
  @@index([projectId])
}

model EmailMessage {
  id               String      @id @default(uuid()) @db.Uuid
  threadId         String      @db.Uuid
  direction        String // INBOUND | OUTBOUND
  fromAddress      String
  toAddresses      String[]
  ccAddresses      String[]    @default([])
  subject          String
