  @@index([eapProjectId, orderIndex])
}

model ScheduleSegment {
  id              String          @id @default(uuid()) @db.Uuid
  packageId       String          @db.Uuid
  zoneCode        String
  segmentOrder    Int             @default(1)
  startDate       DateTime
  endDate         DateTime
  workingDays     Int
  parallelLane    Int             @default(1)
  progressPercent Float           @default(0)
  notes           String?
  package         SchedulePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, segmentOrder])
}

model ProcurementGate {
  id           String          @id @default(uuid()) @db.Uuid
  packageId    String          @db.Uuid
  title        String
  leadTimeDays Int
  triggerDate  DateTime
  status       String          @default("PENDENTE") // PENDENTE | EM_COTACAO | COMPRADO | ENTREGUE
  package      SchedulePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, status])
  @@index([triggerDate])
}

model WorkMeasurement {
  id                      String     @id @default(uuid()) @db.Uuid
  eapProjectId            String     @db.Uuid
  referenceDate           DateTime
  periodLabel             String
  physicalProgressPercent Float      @default(0)
  realizedMaterialCost    Float      @default(0)
  realizedLaborCost       Float      @default(0)
  realizedThirdPartyCost  Float      @default(0)
  notes                   String?
  detailsJson             Json       @default("{}")
  eapProject              EapProject @relation(fields: [eapProjectId], references: [id], onDelete: Cascade)
  createdAt               DateTime   @default(now())

  @@index([eapProjectId, referenceDate])
}

model EapServicePackage {
  id                  String     @id @default(uuid()) @db.Uuid
  eapProjectId        String     @db.Uuid
  packageNumber       Int
  name                String
  discipline          String
  corHex              String
  textHex             String
  predecessorNumbers  Int[]      @default([])
  productivityPerDay  Float      @default(1)
  productivityUnit    String     @default("un/dia")
  linkedEapStageCodes String[]   @default([])
  isActive            Boolean    @default(true)
  eapProject          EapProject @relation(fields: [eapProjectId], references: [id], onDelete: Cascade)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@unique([eapProjectId, packageNumber])
  @@index([eapProjectId, isActive])
}

model EapWorkTeam {
  id                    String          @id @default(uuid()) @db.Uuid
  eapProjectId          String          @db.Uuid
  teamCode              String
  name                  String
  specialty             String
  maxDailyHours         Float           @default(8.0)
  maxSimultaneousFronts Int             @default(1)
  isActive              Boolean         @default(true)
  eapProject            EapProject      @relation(fields: [eapProjectId], references: [id], onDelete: Cascade)
  workers               EapTeamWorker[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([eapProjectId, teamCode])
  @@index([eapProjectId, isActive])
}

model EapTeamWorker {
  id               String      @id @default(uuid()) @db.Uuid
  teamId           String      @db.Uuid
  roleName         String
  headcount        Int         @default(1)
  dailyRate        Float
  hourlyRate       Float
  socialChargesPct Float       @default(0)
  maxDailyOutput   Float?
  team             EapWorkTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([teamId])
}

model EapLobFloorAllocation {
  id            String     @id @default(uuid()) @db.Uuid
  eapProjectId  String     @db.Uuid
  floorId       String
  floorName     String
  floorOrder    Int        @default(0)
  dateIso       String
  teamCode      String
  packageNumber Int
  isOvertime    Boolean    @default(false)
  dataOrigin    String     @default("PRELIMINAR_PADRAO") // PRELIMINAR_PADRAO | QUANTITATIVO_IMPORTADO | EDITADO_USUARIO
  eapProject    EapProject @relation(fields: [eapProjectId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([eapProjectId, floorId, dateIso, teamCode, packageNumber])
  @@index([eapProjectId, floorOrder, dateIso])
}

model EapConstraint {
  id                String     @id @default(uuid()) @db.Uuid
  eapProjectId      String     @db.Uuid
  title             String
  description       String?
  category          String     @default("COMPRAS_SUPRIMENTOS") // COMPRAS_SUPRIMENTOS | PROJETO_DEFINICAO | MAO_DE_OBRA | EQUIPAMENTOS | LICENCAS_APROVACOES | LOGISTICA_CANTEIRO
  status            String     @default("IDENTIFICADA") // IDENTIFICADA | EM_COTACAO_ANALISE | PEDIDO_EMITIDO | LIBERADA | BLOQUEADA
  priority          String     @default("MEDIA") // BAIXA | MEDIA | ALTA | CRITICA
  floorId           String?
  floorName         String?
  packageNumber     Int?
  teamCode          String?
  linkedEapItemId   String?    @db.Uuid
  neededByDate      DateTime
  leadTimeDays      Int        @default(7)
  orderDeadlineDate DateTime?
  estimatedCost     Float?
  supplierName      String?
  responsibleName   String?
  resolvedAt        DateTime?
  eapProject        EapProject @relation(fields: [eapProjectId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([eapProjectId, status])
  @@index([eapProjectId, neededByDate])
}

model EapFieldMeasurementBulletin {
  id                  String                     @id @default(uuid()) @db.Uuid
  eapProjectId        String                     @db.Uuid
  bulletinNumber      Int
  referenceDate       DateTime
  periodStart         DateTime?
  periodEnd           DateTime?
  status              String                     @default("RASCUNHO") // RASCUNHO | APROVADO
  inspectorName       String?
  weatherCondition    String?                    // SOL | NUBLADO | CHUVA_PARCIAL | CHUVA_INTENSA
  generalNotes        String?
  totalMeasuredValue  Float                      @default(0)
  physicalProgressPct Float                      @default(0)
  eapProject          EapProject                 @relation(fields: [eapProjectId], references: [id], onDelete: Cascade)
  entries             EapFieldMeasurementEntry[]
  evidences           EapMeasurementEvidence[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([eapProjectId, bulletinNumber])
  @@index([eapProjectId, referenceDate])
}

model EapFieldMeasurementEntry {
  id                  String                      @id @default(uuid()) @db.Uuid
  bulletinId          String                      @db.Uuid
  eapProjectId        String                      @db.Uuid
  floorId             String
  floorName           String
  packageNumber       Int?
  teamCode            String?
  eapItemId           String?                     @db.Uuid
  serviceLabel        String
  unit                String
  plannedQty          Float
  previousExecutedQty Float                       @default(0)
  currentExecutedQty  Float                       @default(0)
  accumulatedPct      Float                       @default(0)
  unitPrice           Float                       @default(0)
  measuredAmount      Float                       @default(0)
  status              String                      @default("PENDENTE") // PENDENTE | EM_ANDAMENTO | CONCLUIDO | IMPEDIDO
  fieldNote           String?
  bulletin            EapFieldMeasurementBulletin @relation(fields: [bulletinId], references: [id], onDelete: Cascade)
  eapProject          EapProject                  @relation(fields: [eapProjectId], references: [id], onDelete: Cascade)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([bulletinId, floorId])
  @@index([eapProjectId, floorId])
}

model EapProcurementItem {
  id                String     @id @default(uuid()) @db.Uuid
  eapProjectId      String     @db.Uuid
  packageId         String?    @db.Uuid
  packageNumber     Int?
  packageName       String
  stageCode         String?
  itemName          String
  category          String     @default("MATERIAL") // MATERIAL | TERCEIROS | EQUIPAMENTO
  unit              String     @default("un")
  quantity          Float      @default(1)
  estimatedAmount   Float      @default(0)
  closedAmount      Float?
  supplierName      String?
  needDate          DateTime
  leadTimeDays      Int        @default(10)
  orderDeadlineDate DateTime
  status            String     @default("A_COTAR") // A_COTAR | EM_COTACAO | PEDIDO_EMITIDO | ENTREGUE
  financialEntryId  String?    @db.Uuid
  notes             String?
  eapProject        EapProject @relation(fields: [eapProjectId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([eapProjectId, status])
  @@index([eapProjectId, orderDeadlineDate])
  @@index([packageNumber])
}

model EapMeasurementEvidence {
  id           String                       @id @default(uuid()) @db.Uuid
  eapProjectId String                       @db.Uuid
  bulletinId   String?                      @db.Uuid
  rowKey       String
  floorId      String
  floorName    String
  eapItemId    String?                      @db.Uuid
  serviceLabel String
  mediaType    String                       // IMAGE | VIDEO
  fileName     String
  mimeType     String
  sizeBytes    Int                          @default(0)
  storageKey   String
  dataBase64   String?                      @db.Text
  durationSec  Float?
  capturedAt   DateTime                     @default(now())
  eapProject   EapProject                   @relation(fields: [eapProjectId], references: [id], onDelete: Cascade)
  bulletin     EapFieldMeasurementBulletin? @relation(fields: [bulletinId], references: [id], onDelete: SetNull)
  createdAt    DateTime                     @default(now())

  @@index([eapProjectId, rowKey])
  @@index([bulletinId])
  @@index([eapProjectId, capturedAt])
}
